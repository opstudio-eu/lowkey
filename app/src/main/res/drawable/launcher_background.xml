<?xml version="1.0" encoding="utf-8"?>
<!-- Keep the paper artwork inside launcher masks, including circular icons. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#17659C" />
        </shape>
    </item>
    <item android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp">
        <bitmap android:src="@drawable/launcher_artwork"
            android:gravity="fill" android:filter="true" />
    </item>
</layer-list>
