<resources>
    <!-- OpStudio brand: dark (#101E2B) on light (#F4F8FB); see companion/theme/Theme.kt. -->
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#17659C</item>
        <item name="android:windowBackground">#F4F8FB</item>
        <item name="android:colorBackground">#F4F8FB</item>
    </style>

    <!-- The keyboard's image prompt window: a transparent layer over the app, undimmed, with its card
         just above the keyboard. -->
    <style name="AiPromptTheme" parent="android:style/Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <!-- The card draws its own shadow; the window itself stays invisible. -->
        <item name="android:windowElevation">0dp</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
